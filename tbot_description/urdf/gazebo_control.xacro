<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===== ros2_control: which joints are controlled and how ===== -->
  <xacro:macro name="wheel_control" params="joint">
    <joint name="${joint}">
      <command_interface name="velocity"/>   <!-- we SEND wheel speed -->
      <state_interface name="velocity"/>     <!-- we READ wheel speed  -->
      <state_interface name="position"/>     <!-- we READ wheel angle (like an encoder) -->
    </joint>
  </xacro:macro>

  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>   <!-- later: your ESP32 interface -->
    </hardware>
    <xacro:wheel_control joint="front_left_wheel_joint"/>
    <xacro:wheel_control joint="front_right_wheel_joint"/>
    <xacro:wheel_control joint="rear_left_wheel_joint"/>
    <xacro:wheel_control joint="rear_right_wheel_joint"/>
  </ros2_control>

  <!-- ===== Gazebo plugin that runs ros2_control inside the simulation ===== -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find tbot_description)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- ===== Friction: wheels grip, chassis slides ===== -->
  <xacro:macro name="wheel_friction" params="link">
    <gazebo reference="${link}">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>
  <xacro:wheel_friction link="front_left_wheel"/>
  <xacro:wheel_friction link="front_right_wheel"/>
  <xacro:wheel_friction link="rear_left_wheel"/>
  <xacro:wheel_friction link="rear_right_wheel"/>

</robot>