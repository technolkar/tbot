<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tbot">

  <!-- ============ PARAMETERS: replace with YOUR measurements (metres, kg) ============ -->
  <xacro:property name="chassis_length"   value="0.25"/>
  <xacro:property name="chassis_width"    value="0.15"/>
  <xacro:property name="chassis_height"   value="0.05"/>
  <xacro:property name="chassis_mass"     value="0.8"/>
  <xacro:property name="chassis_z_offset" value="0.01"/>   <!-- wheel axle to chassis bottom -->

  <xacro:property name="wheel_radius" value="0.0325"/>
  <xacro:property name="wheel_width"  value="0.026"/>
  <xacro:property name="wheel_mass"   value="0.05"/>
  <xacro:property name="wheelbase"    value="0.13"/>       <!-- front axle to rear axle -->
  <xacro:property name="track_width"  value="0.18"/>       <!-- left wheel centre to right wheel centre -->

  <xacro:property name="lidar_radius" value="0.035"/>
  <xacro:property name="lidar_height" value="0.04"/>
  <xacro:property name="lidar_mass"   value="0.17"/>
  <xacro:property name="lidar_x"      value="0.0"/>        <!-- forward offset from chassis centre -->

  <!-- ============ MATERIALS (colours for RViz) ============ -->
  <material name="orange"><color rgba="1.0 0.5 0.0 1.0"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
  <material name="blue"><color rgba="0.2 0.2 0.8 1.0"/></material>

  <!-- ============ INERTIA MACROS (the formulas from the lesson) ============ -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${m/12*(y*y+z*z)}" ixy="0" ixz="0"
               iyy="${m/12*(x*x+z*z)}" iyz="0"
               izz="${m/12*(x*x+y*y)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h rpy">
    <inertial>
      <origin xyz="0 0 0" rpy="${rpy}"/>
      <mass value="${m}"/>
      <inertia ixx="${m/12*(3*r*r+h*h)}" ixy="0" ixz="0"
               iyy="${m/12*(3*r*r+h*h)}" iyz="0"
               izz="${m/2*r*r}"/>
    </inertial>
  </xacro:macro>

  <!-- ============ BASE FRAMES ============ -->
  <link name="base_footprint"/>
  <link name="base_link"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ============ CHASSIS ============ -->
  <link name="chassis">
    <visual>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
    </collision>
    <xacro:box_inertia m="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}"/>
  </link>

  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="0 0 ${chassis_z_offset + chassis_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- ============ WHEEL MACRO (written once, used 4 times) ============ -->
  <xacro:macro name="wheel" params="prefix x_reflect y_reflect">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 0"/>   <!-- turn cylinder so its axis points along y -->
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}" rpy="${-pi/2} 0 0"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${x_reflect*wheelbase/2} ${y_reflect*track_width/2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>                          <!-- wheels spin around y -->
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="front_left"  x_reflect="1"  y_reflect="1"/>
  <xacro:wheel prefix="front_right" x_reflect="1"  y_reflect="-1"/>
  <xacro:wheel prefix="rear_left"   x_reflect="-1" y_reflect="1"/>
  <xacro:wheel prefix="rear_right"  x_reflect="-1" y_reflect="-1"/>

  <!-- ============ LIDAR ============ -->
  <link name="laser_frame">
    <visual>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
    </collision>
    <xacro:cylinder_inertia m="${lidar_mass}" r="${lidar_radius}" h="${lidar_height}" rpy="0 0 0"/>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="chassis"/>
    <child link="laser_frame"/>
    <origin xyz="${lidar_x} 0 ${chassis_height/2 + lidar_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- ============ CAMERA ============ -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.01 0.025 0.025"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><box size="0.01 0.025 0.025"/></geometry>
    </collision>
    <xacro:box_inertia m="0.01" x="0.01" y="0.025" z="0.025"/>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="chassis"/>
    <child link="camera_link"/>
    <origin xyz="${chassis_length/2 + 0.005} 0 0" rpy="0 0 0"/>
  </joint>
  <xacro:include filename="gazebo_control.xacro"/>
</robot>